{
  "name": "jis-companion-unofficial",
  "main": "expo-router/entry",
  "version": "1.1.0",
  "scripts": {
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "build:android:cloud": "eas build -p android --profile production",
    "build:android:local": "shx mkdir -p builds && eas build -p android --profile production --local && shx mv -f *.aab builds",
    "build:web:cloud": "rimraf dist && expo export -p web && node scripts/generate-sw.mjs",
    "build:web:local": "rimraf dist && expo export -p web && node scripts/generate-sw.mjs && (cd dist && zip -rq $(node -p \"require('../package.json').version\").zip .)",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.13.2",
    "expo": "~54.0.26",
    "expo-asset": "~12.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-device": "^8.0.9",
    "expo-file-system": "~19.0.20",
    "expo-font": "~14.0.9",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.9",
    "expo-network": "~8.0.8",
    "expo-random": "^14.0.1",
    "expo-router": "~6.0.16",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.9",
    "lucide-react-native": "^0.556.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "ulid": "^3.0.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "bestzip": "^2.2.1",
    "react-test-renderer": "19.1.0",
    "rimraf": "^6.1.2",
    "shx": "^0.4.0",
    "typescript": "~5.9.2",
    "workbox-build": "^7.4.0"
  },
  "author": "sandipansingh",
  "license": "MIT",
  "private": true
}
