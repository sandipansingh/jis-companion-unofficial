{
  "name": "jis-companion-unofficial",
  "main": "expo-router/entry",
  "version": "1.6.2",
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "build:android:dev:local": "shx mkdir -p builds && eas build -p android --profile development --local && shx mv -f *.apk builds",
    "build:android:dev:cloud": "eas build -p android --profile development",
    "build:android:prod:cloud": "eas build -p android --profile production",
    "build:android:prod:local": "shx mkdir -p builds && eas build -p android --profile production --local && shx mv -f *.aab builds",
    "submit:android": "node scripts/submit-android.mjs",
    "build:web:cloud": "rimraf dist && expo export -p web && node scripts/generate-sw.mjs",
    "build:web:local": "rimraf dist && expo export -p web && node scripts/generate-sw.mjs && (cd dist && zip -rq $(node -p \"require('../package.json').version\").zip .)",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.26",
    "expo-asset": "~12.0.11",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "^8.0.9",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.9",
    "expo-network": "~8.0.8",
    "expo-random": "^14.0.1",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.11",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.9",
    "lucide-react-native": "^0.556.0",
    "nativewind": "^4.2.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "ulid": "^3.0.2",
    "zustand": "^5.0.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "bestzip": "^2.2.1",
    "react-test-renderer": "19.1.0",
    "rimraf": "^6.1.2",
    "shx": "^0.4.0",
    "typescript": "~5.9.2",
    "workbox-build": "^7.4.0"
  },
  "author": "sandipansingh",
  "license": "MIT",
  "private": true
}
